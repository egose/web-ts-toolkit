{
  "name": "web-ts-toolkit",
  "version": "0.68.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present --workspace-concurrency=1 test",
    "test:grouped": "pnpm test:groups:check && node scripts/test-groups.mjs",
    "test:groups:check": "node --test scripts/test-groups.test.mjs && node scripts/test-groups.mjs --check",
    "test:group:1": "node scripts/test-groups.mjs 1",
    "test:group:2": "node scripts/test-groups.mjs 2",
    "test:group:3": "node scripts/test-groups.mjs 3",
    "test:group:4": "node scripts/test-groups.mjs 4",
    "test:group:5": "node scripts/test-groups.mjs 5",
    "test:group:6": "node scripts/test-groups.mjs 6",
    "test:group:7": "node scripts/test-groups.mjs 7",
    "test:group:8": "node scripts/test-groups.mjs 8",
    "test:group:9": "node scripts/test-groups.mjs 9",
    "test:group:10": "node scripts/test-groups.mjs 10",
    "test:group:11": "node scripts/test-groups.mjs 11",
    "test:group:12": "node scripts/test-groups.mjs 12",
    "release": "release-it",
    "changelog": "repo-toolkit-changelog",
    "publish-packages": "node scripts/publish-packages.mjs",
    "bench:access-router": "node scripts/benchmarks/access-router.mjs",
    "build-artifact": "repo-toolkit-build-artifact --config release-artifact.config.json",
    "verify-artifact": "repo-toolkit-verify-artifact --config release-artifact.config.json"
  },
  "keywords": [],
  "author": "Junmin Ahn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egose/web-ts-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/egose/web-ts-toolkit/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/format": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@release-it/bumper": "^8.0.1",
    "@repo-toolkit/changelog": "^0.41.1",
    "@repo-toolkit/publish-packages": "^0.41.1",
    "@repo-toolkit/release-artifact": "^0.41.1",
    "@types/node": "^26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-mocha-no-only": "^1.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "4.0.0-alpha.13",
    "release-it": "^21.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  }
}
