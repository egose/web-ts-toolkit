{
  "name": "@web-ts-toolkit/oidc-vault-dpop-client",
  "description": "DPoP browser client for @web-ts-toolkit/express-oidc-vault with body+cookie transports",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/oidc-vault-dpop-client",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "oidc",
    "dpop",
    "browser",
    "authentication",
    "proof-of-possession"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm --filter @web-ts-toolkit/oidc-vault-dpop-client... build && pnpm typecheck && vitest run --config ../../vitest.config.ts",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test && pnpm typecheck:nodenext-strict && pnpm typecheck:bundler-strict",
    "typecheck:source": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test-typecheck.json",
    "typecheck:nodenext-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-nodenext.json",
    "typecheck:bundler-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-bundler.json",
    "test:browser-smoke": "pnpm --filter @web-ts-toolkit/oidc-vault-dpop-client build && vitest run --config vitest.browser.config.ts test/*.browser-smoke.ts",
    "test:browser": "DPOP_TEST_BROWSERS=chromium,firefox pnpm --filter oidc-vault-dpop-example test:browser"
  },
  "files": [
    "README.md",
    "llms.txt",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 94",
    "edge >= 94",
    "firefox >= 93",
    "safari >= 16"
  ],
  "dependencies": {
    "idb": "^8.0.3",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@web-ts-toolkit/express-oidc-vault": "workspace:*",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
