{
  "name": "@web-ts-toolkit/json-frame",
  "description": "Normalize and transform any tabular JSON shape (records, columns, split, values, table, index) into a single column-major DataFrame view",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/json-frame",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "dataframe",
    "json",
    "tabular",
    "transform",
    "adapter",
    "typescript"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "bench:jfh-07": "vitest run --config ../../vitest.config.ts test/benchmark/jfh-07.benchmark.test.ts",
    "test": "pnpm typecheck && vitest run --config ../../vitest.config.ts",
    "typecheck": "pnpm --filter @web-ts-toolkit/json-frame... build && pnpm typecheck:source && pnpm typecheck:nodenext-strict && pnpm typecheck:bundler-strict && pnpm typecheck:bundler-browser",
    "typecheck:source": "tsc --noEmit -p tsconfig.json",
    "typecheck:nodenext-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-nodenext.json",
    "typecheck:bundler-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-bundler.json",
    "typecheck:bundler-browser": "tsc --noEmit -p test-decl-consumer/tsconfig-bundler-browser.json",
    "test:packed-consumer": "pnpm --filter @web-ts-toolkit/json-frame build && vitest run --config ../../vitest.config.ts test/packed-consumer.test.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
