{
  "name": "@web-ts-toolkit/moo",
  "description": "Mongoose helpers for schema fields, ObjectId checks, and document plugins",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/moo",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "mongoose",
    "mongodb",
    "schema",
    "plugins",
    "objectid"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./is": {
      "types": "./dist/is.d.ts",
      "import": "./dist/is.mjs",
      "require": "./dist/is.js",
      "default": "./dist/is.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs",
      "require": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./plugins/cascade-delete": {
      "types": "./dist/plugins/cascade-delete.d.ts",
      "import": "./dist/plugins/cascade-delete.mjs",
      "require": "./dist/plugins/cascade-delete.js",
      "default": "./dist/plugins/cascade-delete.js"
    },
    "./plugins/model-function": {
      "types": "./dist/plugins/model-function.d.ts",
      "import": "./dist/plugins/model-function.mjs",
      "require": "./dist/plugins/model-function.js",
      "default": "./dist/plugins/model-function.js"
    },
    "./plugins/new-document": {
      "types": "./dist/plugins/new-document.d.ts",
      "import": "./dist/plugins/new-document.mjs",
      "require": "./dist/plugins/new-document.js",
      "default": "./dist/plugins/new-document.js"
    },
    "./plugins/keycloak-user-sync": {
      "types": "./dist/plugins/keycloak-user-sync.d.ts",
      "import": "./dist/plugins/keycloak-user-sync.mjs",
      "require": "./dist/plugins/keycloak-user-sync.js",
      "default": "./dist/plugins/keycloak-user-sync.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm --filter @web-ts-toolkit/moo... build && vitest run --config ../../vitest.config.ts --maxWorkers=1"
  },
  "files": [
    "README.md",
    "llms.txt",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@egose/keycloak-fluent": "^0.7.0 || ^0.12.0",
    "mongoose": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@egose/keycloak-fluent": {
      "optional": true
    }
  },
  "dependencies": {
    "@web-ts-toolkit/utils": "workspace:*"
  },
  "devDependencies": {
    "@egose/keycloak-fluent": "^0.12.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.8.0"
  }
}
