{
  "name": "@web-ts-toolkit/access-router-react",
  "description": "React hooks for @web-ts-toolkit/access-router-client model services",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/access-router-react",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "repository": "PLACEHOLDER",
  "keywords": [
    "react",
    "hooks",
    "typescript",
    "crud",
    "access-router",
    "model"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm --filter @web-ts-toolkit/access-router-react... build && pnpm typecheck && pnpm test:react19 && pnpm test:react18 && pnpm test:nonruntime",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test && pnpm typecheck:nodenext-strict && pnpm typecheck:bundler-strict",
    "typecheck:source": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test-typecheck.json",
    "test:react19": "vitest run --config vitest.runtime.config.ts",
    "test:react18": "tsx test/run-react18-lane.ts",
    "test:nonruntime": "vitest run --config vitest.config.ts test/access-router-react.exports.unit.test.ts test/access-router-react.packed-consumer.test.ts test/access-router-react.docs.compile.test.ts",
    "typecheck:nodenext-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-nodenext.json",
    "typecheck:bundler-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-bundler.json",
    "test:packed-consumer": "vitest run --config vitest.config.ts test/access-router-react.packed-consumer.test.ts test/access-router-react.docs.compile.test.ts",
    "test:coverage": "pnpm --filter @web-ts-toolkit/access-router-react... build && pnpm typecheck && vitest run --config vitest.config.ts --coverage"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@web-ts-toolkit/access-router-client": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@web-ts-toolkit/access-router-client": "workspace:*",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
