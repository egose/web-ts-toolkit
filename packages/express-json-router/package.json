{
  "name": "@web-ts-toolkit/express-json-router",
  "description": "Express router wrapper for return-value JSON responses",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/express-json-router",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "express",
    "api",
    "json",
    "router",
    "http"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm --filter @web-ts-toolkit/express-json-router... build && pnpm typecheck && vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit -p test-decl-consumer/tsconfig-nodenext.json && tsc --noEmit -p test-decl-consumer/tsconfig-bundler.json"
  },
  "files": [
    "README.md",
    "llms.txt",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@web-ts-toolkit/express-response-handler": "workspace:*",
    "@web-ts-toolkit/http-errors": "workspace:*",
    "@web-ts-toolkit/utils": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "supertest": "^7.2.2"
  }
}
