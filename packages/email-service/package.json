{
  "name": "@web-ts-toolkit/email-service",
  "description": "Typed email preparation, queue and submission contracts for Node.js",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "repository": "PLACEHOLDER",
  "keywords": [
    "email",
    "handlebars",
    "smtp",
    "sendgrid",
    "queue"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./smtp": {
      "types": {
        "import": "./dist/smtp.d.mts",
        "require": "./dist/smtp.d.ts",
        "default": "./dist/smtp.d.ts"
      },
      "import": "./dist/smtp.mjs",
      "require": "./dist/smtp.js",
      "default": "./dist/smtp.js"
    },
    "./sendgrid": {
      "types": {
        "import": "./dist/sendgrid.d.mts",
        "require": "./dist/sendgrid.d.ts",
        "default": "./dist/sendgrid.d.ts"
      },
      "import": "./dist/sendgrid.mjs",
      "require": "./dist/sendgrid.js",
      "default": "./dist/sendgrid.js"
    },
    "./mongoose": {
      "types": {
        "import": "./dist/mongoose.d.mts",
        "require": "./dist/mongoose.d.ts",
        "default": "./dist/mongoose.d.ts"
      },
      "import": "./dist/mongoose.mjs",
      "require": "./dist/mongoose.js",
      "default": "./dist/mongoose.js"
    },
    "./attachments": {
      "types": {
        "import": "./dist/attachments.d.mts",
        "require": "./dist/attachments.d.ts",
        "default": "./dist/attachments.d.ts"
      },
      "import": "./dist/attachments.mjs",
      "require": "./dist/attachments.js",
      "default": "./dist/attachments.js"
    },
    "./attachments/mongoose": {
      "types": {
        "import": "./dist/attachments-mongoose.d.mts",
        "require": "./dist/attachments-mongoose.d.ts",
        "default": "./dist/attachments-mongoose.d.ts"
      },
      "import": "./dist/attachments-mongoose.mjs",
      "require": "./dist/attachments-mongoose.js",
      "default": "./dist/attachments-mongoose.js"
    },
    "./attachments/s3": {
      "types": {
        "import": "./dist/attachments-s3.d.mts",
        "require": "./dist/attachments-s3.d.ts",
        "default": "./dist/attachments-s3.d.ts"
      },
      "import": "./dist/attachments-s3.mjs",
      "require": "./dist/attachments-s3.js",
      "default": "./dist/attachments-s3.js"
    },
    "./attachments/azure": {
      "types": {
        "import": "./dist/attachments-azure.d.mts",
        "require": "./dist/attachments-azure.d.ts",
        "default": "./dist/attachments-azure.d.ts"
      },
      "import": "./dist/attachments-azure.mjs",
      "require": "./dist/attachments-azure.js",
      "default": "./dist/attachments-azure.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:package",
    "build:package": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/run.mjs",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:lifecycle": "vitest run --config vitest.lifecycle.config.mts",
    "test:smtp": "vitest run --config vitest.smtp.config.mts",
    "test:sendgrid": "vitest run --config vitest.sendgrid.config.mts",
    "test:mongodb": "vitest run --config vitest.mongodb.config.mts",
    "test:s3": "node test/s3/run.mjs",
    "test:azure": "node test/azure/run.mjs",
    "test:managed-delivery": "node test/managed-delivery/run.mjs",
    "test:packed-consumer": "node --test test/packed-consumer/packaging.test.mjs"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.1167.0 <4",
    "@azure/storage-blob": ">=12.34.0 <13",
    "mongoose": ">=9.12.2 <10",
    "nodemailer": ">=10.6.0 <11"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "dependencies": {
    "handlebars": "~4.7.10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@azure/storage-blob": "12.34.0",
    "azurite": "3.38.0",
    "mongoose": "9.12.2",
    "nodemailer": "10.6.0"
  }
}
