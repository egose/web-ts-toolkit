{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/unit/**/*.ts",
    "test/lifecycle/**/*.ts",
    "test/smtp/**/*.ts",
    "test/sendgrid/**/*.ts",
    "test/mongodb/**/*.ts",
    "tsup.config.ts",
    "vitest*.config.mts"
  ]
}
