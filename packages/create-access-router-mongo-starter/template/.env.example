# Shared API route prefix for the backend, Vite dev proxy, and frontend client.
# Use a path-only prefix beginning with /. URLs, // authorities, queries,
# fragments, backslashes, and . or .. segments are rejected.
API_BASE_URL=/api

# MongoDB connection string. Required through the runtime `db.url` in
# `api/access-router.config.ts` for every runtime (local dev server,
# serverless bundle). Accepts single-host, authenticated, bracketed-IPv6, and
# multi-host seed-list forms using mongodb:// or mongodb+srv:// (for example a
# replica set such as mongodb://db-a:27017,db-b:27017/<db>?replicaSet=rs0).
# Use any MongoDB instance: local, Atlas, or another hosted provider.
MONGODB_URI=mongodb://localhost:27017/{{DB_NAME}}
