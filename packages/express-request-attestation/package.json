{
  "name": "@web-ts-toolkit/express-request-attestation",
  "description": "Versioned per-request HMAC signing and replay detection for Express APIs with a browser-safe signer entry",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/express-request-attestation",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "express",
    "hmac",
    "replay",
    "attestation",
    "webcrypto"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./signer": {
      "types": {
        "import": "./dist/signer.d.mts",
        "require": "./dist/signer.d.ts",
        "default": "./dist/signer.d.ts"
      },
      "import": "./dist/signer.mjs",
      "require": "./dist/signer.js",
      "default": "./dist/signer.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.signer-browser.json",
    "test": "pnpm build && pnpm test:node && pnpm test:redis && pnpm test:mongo && pnpm test:browser && pnpm test:packed-consumer",
    "test:node": "vitest run --config vitest.node.config.mts",
    "test:redis": "vitest run --config vitest.redis.config.mts",
    "test:mongo": "vitest run --config vitest.mongo.config.mts",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:packed-consumer": "vitest run --config vitest.packed-consumer.config.mts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "express": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@vitest/browser-playwright": "^4.1.10",
    "express": "^5.2.1",
    "mongodb": "^6.20.0",
    "mongodb-memory-server": "^11.2.0",
    "playwright": "^1.62.1",
    "redis": "^5.9.0"
  }
}
