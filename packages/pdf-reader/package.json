{
  "name": "@web-ts-toolkit/pdf-reader",
  "description": "Resource-safe browser PDF rendering, text extraction, and embedded-image extraction built on PDF.js",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/pdf-reader",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "pdf",
    "pdfjs",
    "browser",
    "canvas",
    "text-extraction",
    "typescript"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "benchmark": "pnpm --filter @web-ts-toolkit/pdf-reader build && vitest run --config vitest.benchmark.config.mts",
    "test": "pnpm --filter @web-ts-toolkit/pdf-reader... build && vitest run --config vitest.config.mts && pnpm test:browser",
    "test:browser": "pnpm --filter @web-ts-toolkit/pdf-reader build && vitest run --config vitest.browser.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "pdfjs-dist": "~6.2.108"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.10",
    "pdfjs-dist": "~6.2.108",
    "playwright": "^1.62.1"
  }
}
