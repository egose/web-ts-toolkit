{
  "name": "@web-ts-toolkit/access-router-client",
  "description": "Typed client utilities for @web-ts-toolkit/access-router APIs",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/access-router-client",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "axios",
    "typescript",
    "api-client",
    "batching",
    "access-router"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm typecheck && vitest run --config ../../vitest.config.ts && vitest run --config vitest.browser.config.ts",
    "typecheck": "pnpm --filter @web-ts-toolkit/access-router-client... build && pnpm typecheck:source && pnpm typecheck:nodenext-strict && pnpm typecheck:bundler-strict",
    "typecheck:source": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:nodenext-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-nodenext.json",
    "typecheck:bundler-strict": "tsc --noEmit -p test-decl-consumer/tsconfig-bundler.json",
    "test:browser-smoke": "pnpm --filter @web-ts-toolkit/access-router-client build && vitest run --config vitest.browser.config.ts test/access-router-client.browser-smoke.ts"
  },
  "files": [
    "README.md",
    "llms.txt",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "supports es2022-module"
  ],
  "dependencies": {
    "@web-ts-toolkit/utils": "workspace:*",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.5",
    "@web-ts-toolkit/access-router": "workspace:*",
    "express": "^5.2.1",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.8.0",
    "zod": "^4.1.12"
  }
}
