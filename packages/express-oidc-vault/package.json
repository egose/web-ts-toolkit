{
  "name": "@web-ts-toolkit/express-oidc-vault",
  "description": "OIDC session middleware for Express with body or cookie transport and pluggable vault stores",
  "homepage": "https://web-ts-toolkit.pages.dev/docs/packages/express-oidc-vault",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "express",
    "oidc",
    "oauth",
    "session",
    "authentication"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm --filter @web-ts-toolkit/express-oidc-vault... build && vitest run --config ../../vitest.config.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "express": ">=5.0.0"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^25.9.5",
    "express": "^5.2.1",
    "supertest": "^7.2.2"
  }
}
