# Consumed by Vite and the Node/tsx server scripts. Copy to .env if needed.
VITE_BACKEND_ORIGIN=http://127.0.0.1:4318
VITE_VAULT_BASE_PATH=/auth/oidc
FRONTEND_ORIGIN=http://127.0.0.1:4317
BACKEND_ORIGIN=http://127.0.0.1:4318
PORT=4318
VAULT_BASE_PATH=/auth/oidc
IDP_MODE=fixture
IDP_PORT=4319
LOCAL_TOKEN_LIFETIME_SECONDS=30
DPOP_NONCE_LIFETIME_SECONDS=60

# For an external development IdP, set IDP_MODE=external and configure these:
# OIDC_ISSUER=https://your-idp.example/tenant
# OIDC_CLIENT_ID=your-client
# OIDC_CLIENT_SECRET=your-confidential-client-secret
# OIDC_SCOPES=openid email profile
# Optional manual mode requires all authorization/token/JWKS endpoints:
# OIDC_AUTHORIZATION_ENDPOINT=https://your-idp.example/authorize
# OIDC_TOKEN_ENDPOINT=https://your-idp.example/token
# OIDC_JWKS_URI=https://your-idp.example/jwks
# OIDC_USERINFO_ENDPOINT=https://your-idp.example/userinfo

# Omitted secrets are freshly random per server startup (this memory-store demo).
# To pin them, use canonical base64url of >=32 random bytes, never a public value:
# LOCAL_JWT_SECRET=...
# DPOP_NONCE_SECRET=...
# DPOP_NONCES=off
