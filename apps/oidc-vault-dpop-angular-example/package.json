    "rxjs": "^7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular/build": "^22.0.0",
    "@angular/compiler-cli": "^22.2.1",
    "@types/node": "^25.9.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.14"
