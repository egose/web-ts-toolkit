  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "FRONTEND_ORIGIN=http://127.0.0.1:4322 BACKEND_ORIGIN=http://127.0.0.1:4350 PORT=4350 IDP_PORT=4351 pnpm --filter oidc-vault-dpop-example dev:server",
