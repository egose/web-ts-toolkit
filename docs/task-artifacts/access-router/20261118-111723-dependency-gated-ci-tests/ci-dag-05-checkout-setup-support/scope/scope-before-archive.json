    "lint": {
      "source": "  lint:\n    runs-on: ubuntu-24.04\n    steps:\n    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n\n    - name: Setup Tools\n      uses: ./.github/actions/setup-tools\n\n    - name: Setup NPM packages\n      uses: ./.github/actions/setup-npm\n\n    - name: Run lint\n      run: pnpm lint\n",
      "bytes": 297,
      "sha256": "42bb672c52751f51dabc426dc624610d88cd0fd16b7112ca09501049efa48c9e"
    },
    "access-router-minimum-node-smoke": {
      "source": "  access-router-minimum-node-smoke:\n    runs-on: ubuntu-24.04\n    steps:\n    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n\n    - name: Pin minimum access-router Node version\n      run: |\n        printf 'nodejs 24.0.0\\npython 3.14.6\\npnpm 11.21.0\\n' > .tool-versions\n\n    - name: Setup Tools\n      uses: ./.github/actions/setup-tools\n\n    - name: Setup NPM packages\n      uses: ./.github/actions/setup-npm\n\n    - name: Run access-router packed consumer smoke\n      run: |\n        mkdir -p _tmp-node24-access-router\n        git check-ignore _tmp-node24-access-router\n        export TMPDIR=\"$PWD/_tmp-node24-access-router\"\n        node --version\n        pnpm --version\n        pnpm --filter @web-ts-toolkit/access-router... build\n        pnpm --filter @web-ts-toolkit/access-router exec vitest run --config vitest.contracts.config.ts test/contracts/packed-consumer-compatibility.test.ts --testNamePattern \"supports minimum peers from release-artifact tarballs across ESM, CJS, NodeNext, and Bundler consumers\"\n",
      "bytes": 1028,
      "sha256": "c6853dbe4a2cb7fff2094e2d6b59f20a973f3fae4f4c8e05a4d48beb59df0a76"
    },
    "access-router-react-minimum-node": {
      "source": "  access-router-react-minimum-node:\n    runs-on: ubuntu-24.04\n    strategy:\n      fail-fast: false\n      matrix:\n        lane: [supported, floating]\n    continue-on-error: ${{ matrix.lane == 'floating' }}\n    steps:\n    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n\n    - name: Setup build tools\n      uses: ./.github/actions/setup-tools\n\n    - name: Setup NPM packages\n      uses: ./.github/actions/setup-npm\n\n    - name: Install library runtime floor\n      run: asdf install nodejs 24.0.0\n\n    - name: Build installed consumer artifacts\n      run: pnpm --filter @web-ts-toolkit/access-router-react... build\n\n    - name: Verify both React majors on Node 24.0.0\n      env:\n        ACCESS_ROUTER_REACT_EXPECT_NODE: 24.0.0\n        ACCESS_ROUTER_REACT_FLOATING: ${{ matrix.lane == 'floating' && '1' || '0' }}\n        ACCESS_ROUTER_REACT_REPORT_DIR: ${{ runner.temp }}/react-consumer-reports\n      run: |\n        mkdir -p _tmp-node24-access-router-react\n        git check-ignore _tmp-node24-access-router-react\n        export TMPDIR=\"$PWD/_tmp-node24-access-router-react\"\n        export ACCESS_ROUTER_REACT_CONSUMER_NODE=\"$(asdf where nodejs 24.0.0)/bin/node\"\n        \"$ACCESS_ROUTER_REACT_CONSUMER_NODE\" --version\n        pnpm --filter @web-ts-toolkit/access-router-react test:packed-consumer\n\n    - name: Save resolved dependency evidence\n      if: always()\n      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n      with:\n        name: react-minimum-node-${{ matrix.lane }}\n        path: ${{ runner.temp }}/react-consumer-reports\n",
      "bytes": 1574,
      "sha256": "182e3960152c375a9ec14ed240f9795239618d7038ed0bc8bbfbad883ba67829"
    }
  },
