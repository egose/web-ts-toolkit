+    if (
+      current.authorization !== authorization ||
+      current.authorizationBinding !== binding ||
+      !sameCopyStrings(binding.scopePath, scope) ||
+      !sameCopyStrings(current.effectiveSelectNorm, selection)
+    )
+      return copyOutputValue(value, current, path, construction, prepaid);
+    return copy(value, path, construction, prepaid);
+  };
+}
