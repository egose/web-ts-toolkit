+export function prepareSelectedOutputCopy(plan: OutputSelectionShape): PreparedOutputValueCopy {
+  const authorization = plan.authorization!,
+    binding = plan.authorizationBinding!;
+  const selection = Object.freeze(plan.effectiveSelectNorm.slice());
+  const scope = Object.freeze((binding.scopePath ?? []).slice());
+  const copy = prepareOutputValueCopy({
+    authorization,
