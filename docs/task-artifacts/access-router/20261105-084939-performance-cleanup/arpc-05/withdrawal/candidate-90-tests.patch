index 0000000..1ace230
--- /dev/null
+++ b/packages/access-router/test/service-lazy-logging.unit.test.ts
@@ -0,0 +1,240 @@
+import mongoose from 'mongoose';
+import { afterAll, afterEach, describe, expect, it, vi } from 'vitest';
+import * as fs from 'node:fs/promises';
+import path from 'node:path';
+import type { AccessRouterLogger, AuthorizationMode } from '../src/interfaces';
+import * as logging from '../src/logger-helpers';
+import { defaultLogger } from '../src/logger-default';
+import { caseId, createCrudFixture, operations, type CrudCase } from './access-router-crud-fixture';
+import { quietOutput, sourceModes } from './owned-stage-test-fixture';
+import { writeOutputFixture } from './write-output-test-fixture';
+
+const work: unknown[] = [];
+afterAll(async () => {
+  if (!process.env.ARPC_LOGGING_WORK_REPORT) return;
+  const target = path.resolve(process.env.ARPC_LOGGING_WORK_REPORT);
+  expect(target.startsWith(`${path.resolve(process.env.TMPDIR!)}${path.sep}`)).toBe(true);
+  await fs.writeFile(target, JSON.stringify(work));
+});
+afterEach(() => vi.restoreAllMocks());
+
+const stableMessages = (messages: string[]) => messages.map((message) => {
+  const { startedAt: _start, durationMs: _duration, ...stable } = JSON.parse(message);
+  return stable;
+});
+
+const cases: CrudCase[] = sourceModes.flatMap((mode) => (['direct', 'public'] as const).flatMap((entry) =>
+  operations.filter((operation) => entry !== 'public' || operation !== 'update-filter').map((operation) => {
+    const spec = { modes: Array<AuthorizationMode>(4).fill(mode), entry, operation, shape: 'hooks' as const, rows: 4, width: 4 };
+    return { ...spec, id: caseId(spec) };
+  }),
+));
+
+describe('real service lazy debug summaries', () => {
+  it.each(cases)('$id skips disabled summaries without changing queries, hooks, writes or output', async (c) => {
+    const f = createCrudFixture(c, true);
+    const summaries = vi.spyOn(logging, 'summarizeFilter');
+    const messages: string[] = [];
+    const debug = vi.fn(function (this: AccessRouterLogger, message: string) {
+      expect(this).toBe(logger);
+      messages.push(message);
+    });
+    const level = vi.fn(function (this: AccessRouterLogger, name: string) {
+      expect(this).toBe(logger);
+      expect(name).toBe('debug');
+      return enabled;
+    });
+    let enabled = true;
+    let logger: AccessRouterLogger = { debug, isLevelEnabled: level };
+    f.runtime.setGlobalOptions({ logger });
+    try {
+      const output = f.check(await f.invoke());
+      const counts = { ...f.counts };
+      const trace = [...f.trace];
+      const expectedOps = c.operation.startsWith('create') || (c.entry === 'public' && c.operation === 'upsert-create')
+        ? []
+        : c.operation === 'read-fallback' && c.entry === 'public'
+          ? ['findOne', 'findOne', 'findOne', 'findOne']
+          : c.operation === 'upsert-update' && c.entry === 'direct'
+            ? ['upsert', 'updateOne', 'updateOne', 'upsert']
+            : Array(2).fill(c.operation.startsWith('read') ? 'findOne'
+              : c.operation.startsWith('list') ? 'find'
+                : c.operation === 'upsert-create' ? 'upsert' : 'updateOne');
+      expect(stableMessages(messages).map((m) => m.op)).toEqual(expectedOps);
+      expect(summaries).toHaveBeenCalledTimes(expectedOps.length);
+      expect(level).toHaveBeenCalledTimes(expectedOps.length);
+      const expectedMessages = stableMessages(messages);
+
+      for (const posture of ['disabled', 'missing-level', 'throwing-level', 'throwing-debug'] as const) {
+        f.reset();
+        summaries.mockClear();
+        debug.mockClear();
+        level.mockClear();
+        messages.length = 0;
+        enabled = posture !== 'disabled';
+        logger = {
+          ...(posture === 'missing-level' ? {} : { isLevelEnabled: posture === 'throwing-level' ? function (name) {
+            level.call(this, name);
+            throw new Error('level probe failed');
+          } : level }),
+          debug: posture === 'throwing-debug' ? function (...args) {
+            debug.apply(this, args);
+            throw new Error('debug handler failed');
+          } : debug,
+        };
+        f.runtime.setGlobalOptions({ logger });
+
+        expect(f.check(await f.invoke())).toEqual(output);
+        expect(f.counts).toEqual(counts);
+        expect(f.trace).toEqual(trace);
+        expect(summaries).toHaveBeenCalledTimes(posture === 'disabled' ? 0 : expectedOps.length);
+        expect(debug).toHaveBeenCalledTimes(posture === 'disabled' ? 0 : expectedOps.length);
+        expect(level).toHaveBeenCalledTimes(posture === 'missing-level' ? 0 : expectedOps.length);
+        expect(stableMessages(messages)).toEqual(posture === 'disabled' ? [] : expectedMessages);
+        work.push({ id: c.id, posture, summaries: summaries.mock.calls.length, debugCalls: debug.mock.calls.length,
+          levelChecks: level.mock.calls.length, counts: { ...f.counts }, trace: [...f.trace], messages: stableMessages(messages) });
+      }
+    } finally { f.dispose(); }
+  });
+
+  it.each(sourceModes)('%s large admitted logical/native filters are summarized only for enabled events', async (mode) => {
+    const f = writeOutputFixture(mode, { readAuthorizationMode: mode, listAuthorizationMode: mode });
+    const filter = {
+      $and: [
+        { $or: Array.from({ length: 24 }, (_, index) => ({ value: { $in: [`private-${index}`, /secret/i] } })) },
+        { when: { $gte: new Date(7) }, payload: Buffer.from('private-buffer') },
+        { ownerId: new mongoose.Types.ObjectId('0123456789abcdef01234567') },
+      ],
+    };
+    f.adapter.find.mockResolvedValue([f.stored.toObject()]);
+    const summarize = logging.summarizeFilter;
+    const entries = Object.entries;
+    let insideSummary = false;
+    let summaryTraversals = 0;
+    vi.spyOn(Object, 'entries').mockImplementation((value) => {
+      if (insideSummary) summaryTraversals += 1;
+      return entries(value);
+    });
+    const summaries = vi.spyOn(logging, 'summarizeFilter').mockImplementation((value) => {
+      insideSummary = true;
+      try { return summarize(value); } finally { insideSummary = false; }
+    });
+    const debug = vi.fn();
+    const level = vi.fn(() => false);
+    f.runtime.setGlobalOptions({ logger: { debug, isLevelEnabled: level } });
+    const args = { select: ['value', '-_id'], limit: 5 };
+    const disabled = await f.direct.find(filter, args, quietOutput);
+    expect(disabled).toMatchObject({ success: true, data: [{ value: 'before' }] });
+    expect(summaries).not.toHaveBeenCalled();
+    expect(summaryTraversals).toBe(0);
+    expect(debug).not.toHaveBeenCalled();
+    expect(level).toHaveBeenCalledTimes(2);
+    const admitted = f.adapter.find.mock.calls[0][0].filter;
+    expect(admitted).toEqual({ $and: [{ ...filter.$and[1], ...filter.$and[2] }, filter.$and[0]] });
+    expect(admitted).not.toBe(filter);
+
+    level.mockReturnValue(true);
+    const enabled = await f.public._list(filter, args, quietOutput);
+    expect(enabled).toMatchObject({ success: true, data: [{ value: 'before' }] });
+    expect(f.adapter.find.mock.calls[1][0].filter).toEqual(admitted);
+    expect(summaries).toHaveBeenCalledTimes(2);
+    expect(summaryTraversals).toBeGreaterThan(0);
+    // $and + $or + 24 predicate keys + two native-valued fields + ownerId.
+    const messages = debug.mock.calls.map(([message]) => JSON.parse(message));
+    expect(messages[0]).toEqual({ op: 'find', modelName: f.model.modelName, skip: 0, limit: 5,
+      populateCount: 0, selectCount: 2, filterKeyValueCount: 29, startedAt: expect.any(Number) });
+    expect(messages[1]).toEqual({ op: 'find', modelName: f.model.modelName, filterKeyValueCount: 29,
+      durationMs: expect.any(Number), resultCode: 'success' });
+    expect(JSON.stringify(messages)).not.toMatch(/private|secret|0123456789|\$and|\$in|REDACTED/);
+    expect(f.adapter.find).toHaveBeenCalledTimes(2);
+    expect(f.saves).not.toHaveBeenCalled();
+  });
+
+  it.each(sourceModes.flatMap((mode) => [false, true].map((initial) => ({ mode, initial }))))(
+    '$mode rechecks each event when debug changes from $initial, with unconditional start timing', async ({ mode, initial }) => {
+      const f = writeOutputFixture(mode, { listAuthorizationMode: mode });
+      let enabled = initial;
+      let now = 1000;
+      vi.spyOn(Date, 'now').mockImplementation(() => now);
+      const debug = vi.fn();
+      const isLevelEnabled = vi.fn(() => { now += 100; return enabled; });
+      f.runtime.setGlobalOptions({ logger: { debug, isLevelEnabled } });
+      f.adapter.find.mockImplementation(async () => {
+        enabled = !initial;
+        now = 1250;
+        return [f.stored.toObject()];
+      });
+      const summaries = vi.spyOn(logging, 'summarizeFilter');
+      expect(await f.direct.find({}, { select: ['value', '-_id'] }, quietOutput)).toMatchObject({ success: true });
+      expect(isLevelEnabled).toHaveBeenCalledTimes(2);
+      expect(summaries).toHaveBeenCalledTimes(1);
+      expect(debug).toHaveBeenCalledTimes(1);
+      const message = JSON.parse(debug.mock.calls[0][0]);
+      expect(message).toMatchObject(initial ? { startedAt: 1000 } : { durationMs: 250, resultCode: 'success' });
+      expect(message).not.toHaveProperty(initial ? 'durationMs' : 'startedAt');
+    },
+  );
+
+  it('resolves a replacement logger after the level probe and again at completion', async () => {
+    const f = writeOutputFixture('isolated');
+    const events: string[] = [];
+    const replacement: AccessRouterLogger = {
+      debug(message) { expect(this).toBe(replacement); events.push(JSON.parse(message).resultCode ?? 'begin'); },
+      isLevelEnabled() { expect(this).toBe(replacement); events.push('replacement-level'); return true; },
+    };
+    const original: AccessRouterLogger = {
+      isLevelEnabled() {
+        expect(this).toBe(original);
+        events.push('original-level');
+        f.runtime.setGlobalOptions({ logger: replacement });
+        return true;
+      },
+      debug: vi.fn(),
+    };
+    f.runtime.setGlobalOptions({ logger: original });
+    expect(await f.direct.find({}, {}, quietOutput)).toMatchObject({ success: true });
+    expect(events).toEqual(['original-level', 'begin', 'replacement-level', 'success']);
+    expect(original.debug).not.toHaveBeenCalled();
+  });
+
+  it('retains the default debug fallback and custom receiver when the handler is absent', async () => {
+    const f = writeOutputFixture('trusted');
+    const logger: AccessRouterLogger = {};
+    f.runtime.setGlobalOptions({ logger });
+    const fallback = vi.spyOn(defaultLogger, 'debug').mockImplementation(function (this: unknown) {
+      expect(this).toBe(logger);
+      return defaultLogger;
+    });
+    expect(await f.direct.find({}, {}, quietOutput)).toMatchObject({ success: true });
+    expect(fallback).toHaveBeenCalledTimes(2);
+    expect(stableMessages(fallback.mock.calls.map(([message]) => String(message))).map((m) => m.op)).toEqual(['find', 'find']);
+  });
+
+  it.each(sourceModes.flatMap((mode) => (['direct', 'public'] as const).map((entry) => ({ mode, entry }))))(
+    '$mode $entry DELETE success/miss/denial skips disabled work and keeps enabled structured errors', async ({ mode, entry }) => {
+      for (const outcome of ['success', 'not_found', 'forbidden'] as const) {
+        const f = writeOutputFixture(mode, outcome === 'forbidden' ? { baseFilter: { delete: () => false } } : {});
+        const remove = vi.spyOn(f.stored, 'deleteOne').mockResolvedValue(f.stored as never);
+        const debug = vi.fn();
+        const level = vi.fn(() => false);
+        f.runtime.setGlobalOptions({ logger: { debug, isLevelEnabled: level } });
+        if (outcome === 'not_found') f.adapter.findOne.mockResolvedValue(null);
+        const summaries = vi.spyOn(logging, 'summarizeFilter');
+        const invoke = () => entry === 'direct' ? f.direct.delete('existing') : f.public._delete('existing');
+        expect(await invoke()).toMatchObject({ code: outcome });
+        expect(summaries).not.toHaveBeenCalled();
+        expect(debug).not.toHaveBeenCalled();
+        expect(remove).toHaveBeenCalledTimes(outcome === 'success' ? 1 : 0);
+        expect(f.adapter.findOne).toHaveBeenCalledTimes(outcome === 'forbidden' ? 0 : 1);
+        level.mockReturnValue(true);
+        expect(await invoke()).toMatchObject({ code: outcome });
+        expect(summaries).toHaveBeenCalledTimes(2);
+        expect(stableMessages(debug.mock.calls.map(([message]) => message))).toEqual([
+          { op: 'delete', modelName: f.model.modelName, filterKeyValueCount: outcome === 'forbidden' ? 0 : 1 },
+          { op: 'delete', modelName: f.model.modelName, filterKeyValueCount: outcome === 'forbidden' ? 0 : 1, resultCode: outcome },
+        ]);
+        summaries.mockRestore();
+      }
+    },
+  );
+});
